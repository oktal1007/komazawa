# サイトURL（デプロイ後に変更）
NEXT_PUBLIC_SITE_URL=https://example.com

# Google AdSense クライアントID
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# Google Analytics 測定ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SNSアカウント
NEXT_PUBLIC_TWITTER_HANDLE=your_twitter_handle
NEXT_PUBLIC_GITHUB_HANDLE=your_github_handle

# OEM Research Dashboard
NEXT_PUBLIC_OEM_API_URL=http://localhost:8000

# Anthropic Claude API
ANTHROPIC_API_KEY=your_key

# Keepa API
KEEPA_API_KEY=your_keepa_key

# Amazon SP-API
SP_API_REFRESH_TOKEN=your_token
SP_API_CLIENT_ID=your_client_id
SP_API_CLIENT_SECRET=your_secret
