# ===========================================
# Local Development
# ===========================================

# Backend API URL (Next.js server-side proxy target)
BACKEND_API_URL=http://localhost:8000

# Anthropic Claude API Key (Backend)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Canva OAuth Settings (Backend)
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
CANVA_REDIRECT_URI=http://127.0.0.1:8000/api/canva/callback

# Frontend URL (for CORS in Backend)
FRONTEND_URL=http://localhost:3000

# ===========================================
# Production Deployment
# ===========================================
# Frontend (Vercel):
#   BACKEND_API_URL=https://your-backend.onrender.com
#
# Backend (Render):
#   ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
#   CANVA_CLIENT_ID=your_canva_client_id
#   CANVA_CLIENT_SECRET=your_canva_client_secret
#   CANVA_REDIRECT_URI=https://your-backend.onrender.com/api/canva/callback
#   FRONTEND_URL=https://your-app.vercel.app
